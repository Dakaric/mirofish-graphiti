# LLM API configuration (any LLM API that speaks the OpenAI SDK format works).
# Token usage can be high; consider keeping early simulations below 40 rounds.
LLM_API_KEY=your_api_key_here
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL_NAME=gpt-4o-mini

# ===== Knowledge graph (self-hosted Graphiti + Neo4j; replaces Zep Cloud) =====
# Default values match the docker-compose neo4j service (ports 7475/7688 on host).
NEO4J_URI=bolt://localhost:7688
NEO4J_USER=neo4j
NEO4J_PASSWORD=mirofish-local-change-me
NEO4J_AUTH=neo4j/mirofish-local-change-me

# Graphiti uses non-reasoning models. gpt-5.x reasoning models reject
# reasoning.effort='minimal' that Graphiti sends internally — stick with
# gpt-4o-mini or gpt-4.1-mini for Graphiti calls.

# ===== Boost LLM (optional) =====
# Used by the Reddit simulation for cheaper/faster calls. If not used, REMOVE
# these lines entirely — empty values are NOT allowed.
LLM_BOOST_API_KEY=your_api_key_here
LLM_BOOST_BASE_URL=your_base_url_here
LLM_BOOST_MODEL_NAME=your_model_name_here