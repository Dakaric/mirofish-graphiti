# LLM API configuration (any LLM API that speaks the OpenAI SDK format works).
# Token usage can be high; consider keeping early simulations below 40 rounds.
LLM_API_KEY=your_api_key_here
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL_NAME=gpt-4o-mini

# ===== ZEP memory graph =====
# Free monthly tier is sufficient for simple usage: https://app.getzep.com/
ZEP_API_KEY=your_zep_api_key_here

# ===== Boost LLM (optional) =====
# Used by the Reddit simulation for cheaper/faster calls. If not used, REMOVE
# these lines entirely — empty values are NOT allowed.
LLM_BOOST_API_KEY=your_api_key_here
LLM_BOOST_BASE_URL=your_base_url_here
LLM_BOOST_MODEL_NAME=your_model_name_here